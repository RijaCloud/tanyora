{
    "name": "tanyora-frontend",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.0.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "prepare": "node scripts/setup-git-hooks.mjs",
        "typecheck": "tsc --noEmit",
        "check:mojibake": "node scripts/check-mojibake.mjs",
        "check:staged-copy": "node scripts/check-staged-copy.mjs",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --grep @smoke --project=chromium --project=chromium-mobile",
        "test:e2e:full": "playwright test --project=chromium --project=chromium-mobile",
        "test:e2e:staging": "playwright test --grep @public --project=staging-chromium",
        "test:e2e:staging:cross-browser": "playwright test --grep @public --project=staging-firefox --project=staging-webkit",
        "test:contract": "vitest run tests/contracts",
        "test:all": "pnpm typecheck && pnpm test:unit && pnpm test:e2e:smoke",
        "test:e2e:ui": "playwright test --ui",
        "test:stress": "k6 run tests/stress/public-platform.k6.js",
        "seo:inventory": "node scripts/export-legacy-sitemap-inventory.mjs",
        "cache:migrate-upstash": "node scripts/migrate-upstash-to-redis.mjs"
    },
    "dependencies": {
        "@auth0/nextjs-auth0": "^4.16.0",
        "@hookform/resolvers": "^5.2.2",
        "@next/env": "^14.2.35",
        "@swc/helpers": "^0.5.5",
        "clsx": "^2.1.1",
        "libphonenumber-js": "^1.12.40",
        "lucide-react": "^0.577.0",
        "mongodb": "^7.1.1",
        "next": "^14.2.0",
        "pusher": "^5.3.3",
        "pusher-js": "^8.5.0",
        "quill": "^2.0.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.71.2",
        "react-international-phone": "^4.8.0",
        "react-quill": "^2.0.0",
        "react-slick": "^0.31.0",
        "redis": "^4.7.1",
        "slick-carousel": "^1.8.1",
        "stripe": "^20.4.1",
        "styled-jsx": "^5.1.6",
        "tailwind-merge": "^3.5.0",
        "web-push": "^3.6.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@types/node": "^20.11.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/react-slick": "^0.23.13",
        "@types/web-push": "^3.6.4",
        "autoprefixer": "^10.4.17",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.4.0",
        "vitest": "^4.1.8"
    }
}
